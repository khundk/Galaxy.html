{{ 'ysa-homepage.css' | asset_url | stylesheet_tag }}

<div class="ysa-page" style="max-width: 1100px; margin: 0 auto; padding: 48px 24px;">
  <p style="margin-bottom: 24px;"><a href="{{ routes.root_url }}" style="color: #0c1a2e;">&larr; Back to store</a></p>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start;">
    <div>
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', style: 'width: 100%; height: auto;' }}
      {% endif %}
    </div>
    <div>
      <p style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #6b6560; margin-bottom: 8px;">{{ product.type }}</p>
      <h1 style="font-family: Georgia, serif; font-size: 2.25rem; color: #0c1a2e; margin-bottom: 16px;">{{ product.title }}</h1>
      <p style="font-size: 1.125rem; margin-bottom: 24px;">{{ product.price | money }}</p>
      <div style="margin-bottom: 32px; line-height: 1.8;">{{ product.description }}</div>

      {% form 'product', product %}
        <button type="submit" name="add" class="ysa-btn ysa-btn-dark" style="display: inline-block; padding: 16px 48px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; background: #0c1a2e; color: #fff; border: none; cursor: pointer;">
          Add to cart
        </button>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "ysa-main-product",
  "settings": []
}
{% endschema %}
